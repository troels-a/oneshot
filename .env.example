ONESHOT_API_KEY=change-me
ONESHOT_DASHBOARD_PASSWORD=change-me
ONESHOT_API_PORT=3000
ONESHOT_AGENTS_DIR=./agents
# Base directory for resolving relative --path values in dispatch requests
ONESHOT_WORKSPACE_DIR=
# Public base URL where the server is reachable from the internet (scheme +
# host, plus any path prefix). Used to build full webhook ingest URLs shown in
# the dashboard. Leave blank for same-origin deployments. Examples:
#   ONESHOT_PUBLIC_URL=https://api.example.com
#   ONESHOT_PUBLIC_URL=https://example.com/api
ONESHOT_PUBLIC_URL=
